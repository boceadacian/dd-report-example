# Production values. Copy to .env next to docker-compose.prod.yml on the box, chmod 600, never commit.

# --- Caddy basic auth for https://api.raportcf.ro/admin/* ---
ADMIN_USER=vladian
# docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-long-password'
# Keep the single quotes: bcrypt hashes contain $ sequences that compose would otherwise interpolate.
ADMIN_PASSWORD_HASH=''
# Only this client IP may reach /admin/* (403 for everyone else, before basic auth). If your IP
# changes and you are locked out: edit .env, then `docker compose -f docker-compose.prod.yml restart caddy`.
ADMIN_ALLOWED_IP=109.102.6.31

# --- intake service (same keys as intake/.env.example) ---
PORT=3000
PUBLIC_BASE_URL=https://api.raportcf.ro
ALLOWED_ORIGINS=https://raportcf.ro,https://www.raportcf.ro

# IAM user "dd-intake" scoped to s3://imobile-private-files/dd-experiment/* (see s3-iam-policy.json)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=imobile-private-files
S3_PREFIX=dd-experiment
# Leave both empty on AWS. Set only for a local S3 stand-in (see docker-compose.local.yml).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# Slack: preferred is the platform's bot token (streamprocessing-secret -> slack.oauth.token) posting to a
# channel the bot is in, the same way the DD alerts are sent. The webhook below is the fallback when the
# token is not set. Both are credentials; never log or commit them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=due-diligence
# Slack incoming webhook (Slack app -> Incoming Webhooks -> Add to channel). The URL is the credential.
SLACK_WEBHOOK_URL=

PRESIGNED_URL_TTL_SECONDS=604800
MAX_FILE_BYTES=10485760
MAX_FILES_PER_LEAD=28
MAX_FILES_PER_REQUEST=28
LOG_LEVEL=info
