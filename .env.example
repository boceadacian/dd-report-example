# Production values. Copy to .env next to docker-compose.prod.yml on the box, chmod 600, never commit.

# --- Caddy basic auth for https://api.raportcf.ro/admin/* ---
ADMIN_USER=vladian
# docker run --rm caddy:2 caddy hash-password --plaintext 'choose-a-long-password'
# Keep the single quotes: bcrypt hashes contain $ sequences that compose would otherwise interpolate.
ADMIN_PASSWORD_HASH=''
# Only this client IP may reach /admin/* (403 for everyone else, before basic auth). If your IP
# changes and you are locked out: edit .env, then `docker compose -f docker-compose.prod.yml restart caddy`.
# space-separated IPs or CIDRs, quoted
ADMIN_ALLOWED_IP="109.102.6.31 78.97.14.12"

# --- intake service (same keys as intake/.env.example) ---
PORT=3000
PUBLIC_BASE_URL=https://api.raportcf.ro
# The static site; the customer's report page is LANDING_BASE_URL/raport.html#id.token
LANDING_BASE_URL=https://raportcf.ro
ALLOWED_ORIGINS=https://raportcf.ro,https://www.raportcf.ro

# IAM user "dd-intake" scoped to s3://imobile-private-files/dd-experiment/* (see s3-iam-policy.json)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=imobile-private-files
S3_PREFIX=dd-experiment
# Leave both empty on AWS. Set only for a local S3 stand-in (see docker-compose.local.yml).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# Postgres (the `postgres` service in the compose; leads are stored here, files in S3).
# PGPASSWORD is read by both the postgres container (as its initial password) and the intake.
# Generate: openssl rand -base64 30. Changing it later does NOT change the database password;
# do that with ALTER USER in psql first.
PGHOST=postgres
PGPORT=5432
PGDATABASE=ddintake
PGUSER=ddintake
PGPASSWORD=

# Slack: preferred is the platform's bot token (streamprocessing-secret -> slack.oauth.token) posting to a
# channel the bot is in, the same way the DD alerts are sent. The webhook below is the fallback when the
# token is not set. Both are credentials; never log or commit them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=due-diligence
# Slack incoming webhook (Slack app -> Incoming Webhooks -> Add to channel). The URL is the credential.
SLACK_WEBHOOK_URL=

# Report email through SES (the dd-intake IAM user has ses:SendEmail, see deploy/s3-iam-policy.json).
# SES_FROM must be an address on an identity verified in SES (raportcf.ro). Empty = do not send, log only.
SES_FROM=Raport CF <raport@raportcf.ro>
SES_REPLY_TO=
SES_REGION=eu-central-1
# S3 links inside the customer's report page (the page URL itself never expires); max PDF size.
REPORT_LINK_TTL_SECONDS=900
MAX_REPORT_BYTES=41943040

# Meta Conversions API (server-side copy of the pixel's Lead / Purchase events, deduplicated by event id).
# Pixel id from Events Manager -> Data sources; the token from the pixel's Settings -> Conversions API ->
# Generate access token (a system user token). Both empty = off. The token is a credential.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Events Manager -> Test events -> the TESTxxxxx code. Set while checking, then clear it: events sent with
# a test code do not count in reports.
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0

PRESIGNED_URL_TTL_SECONDS=604800
MAX_FILE_BYTES=10485760
MAX_FILES_PER_LEAD=28
MAX_FILES_PER_REQUEST=28
LOG_LEVEL=info
