# Copy to .bunny.env (gitignored). Storage zone password from the zone's "FTP & API Access" page.
BUNNY_STORAGE_ZONE=raportcf
BUNNY_STORAGE_KEY=
# Storage endpoint for the zone's main region: storage.bunnycdn.com (Falkenstein), uk.storage.bunnycdn.com, ...
BUNNY_STORAGE_HOST=storage.bunnycdn.com
# Optional, for the cache purge after upload: account API key (Account > API) and the pull zone's numeric id.
BUNNY_API_KEY=
BUNNY_PULL_ZONE_ID=
