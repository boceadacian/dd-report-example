{
  "name": "dd-intake",
  "version": "0.1.0",
  "private": true,
  "description": "Lead intake for the /verificare-proprietate ad experiment: saves the lead and its CF files to S3 and pings Slack.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sesv2": "^3.1128.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "fastify": "^5.3.3",
    "pg": "^8.23.0",
    "stripe": "^18.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
