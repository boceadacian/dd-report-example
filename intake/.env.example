# Copy to .env next to docker-compose.yml on the box (chmod 600). Never commit .env.
PORT=3000
PUBLIC_BASE_URL=https://api.raportcf.ro
ALLOWED_ORIGINS=https://raportcf.ro,https://www.raportcf.ro

# IAM user "dd-intake", scoped to the prefix below (see README, deploy/s3-iam-policy.json)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=imobile-private-files
S3_PREFIX=dd-experiment
# Leave both empty on AWS. Set only for a local S3 stand-in (see docker-compose.local.yml).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# Slack: preferred is the platform's bot token (streamprocessing-secret -> slack.oauth.token) posting to a
# channel the bot is in, the same way the DD alerts are sent. The webhook below is the fallback when the
# token is not set. Both are credentials; never log or commit them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=due-diligence
# Slack incoming webhook. The URL is the credential; never log or commit it.
SLACK_WEBHOOK_URL=

# Presigned download links on the admin page; 7 days is the maximum SigV4 allows.
PRESIGNED_URL_TTL_SECONDS=604800
MAX_FILE_BYTES=10485760
MAX_FILES_PER_LEAD=28
MAX_FILES_PER_REQUEST=28
LOG_LEVEL=info
