# Copy to .env next to docker-compose.yml on the box (chmod 600). Never commit .env.
PORT=3000
PUBLIC_BASE_URL=https://api.raportcf.ro
# The static site; the customer's report page is LANDING_BASE_URL/raport.html#id.token
LANDING_BASE_URL=https://raportcf.ro
ALLOWED_ORIGINS=https://raportcf.ro,https://www.raportcf.ro

# IAM user "dd-intake", scoped to the prefix below (see README, deploy/s3-iam-policy.json)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=imobile-private-files
S3_PREFIX=dd-experiment
# Leave both empty on AWS. Set only for a local S3 stand-in (see docker-compose.local.yml).
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=

# Postgres (the `postgres` service in the compose; leads are stored here, files in S3).
# PGPASSWORD is read by both the postgres container (as its initial password) and the intake.
# Generate: openssl rand -base64 30. Changing it later does NOT change the database password;
# do that with ALTER USER in psql first.
PGHOST=postgres
PGPORT=5432
PGDATABASE=ddintake
PGUSER=ddintake
PGPASSWORD=

# Slack: preferred is the platform's bot token (streamprocessing-secret -> slack.oauth.token) posting to a
# channel the bot is in, the same way the DD alerts are sent. The webhook below is the fallback when the
# token is not set. Both are credentials; never log or commit them.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=due-diligence
# Slack incoming webhook. The URL is the credential; never log or commit it.
SLACK_WEBHOOK_URL=

# Report email through SES (the dd-intake IAM user has ses:SendEmail, see deploy/s3-iam-policy.json).
# SES_FROM must be an address on an identity verified in SES (raportcf.ro). Empty = do not send, log only.
SES_FROM=Raport CF <raport@raportcf.ro>
SES_REPLY_TO=
SES_REGION=eu-central-1
# S3 links inside the customer's report page (the page URL itself never expires); max PDF size.
REPORT_LINK_TTL_SECONDS=900
MAX_REPORT_BYTES=41943040

# Stripe Checkout for the second and later report of the same person (email or phone seen before).
# Empty STRIPE_SECRET_KEY = payments off, every lead free. The webhook endpoint is
# https://api.raportcf.ro/stripe/webhook (events checkout.session.completed / async_payment_succeeded).
# The platform's key in paymentservice-secret is a TEST key; use live values to charge real cards.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REPORT_PRICE_RON=150
PAYMENT_ENABLED=true
# Tax rate object in the same Stripe account (VAT 21% RO, inclusive). Empty = no tax line on the checkout.
STRIPE_TAX_RATE_ID=

# Presigned download links on the admin page; 7 days is the maximum SigV4 allows.
PRESIGNED_URL_TTL_SECONDS=604800
MAX_FILE_BYTES=10485760
MAX_FILES_PER_LEAD=28
MAX_FILES_PER_REQUEST=28
LOG_LEVEL=info

# Meta Conversions API; both empty = off. See ../.env.example for where the values come from.
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
META_GRAPH_VERSION=v23.0
